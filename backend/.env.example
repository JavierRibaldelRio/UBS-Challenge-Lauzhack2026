# Copy to .env and fill in. Any OpenAI-compatible endpoint works.
LLM_BASE_URL=https://api.together.xyz/v1
LLM_API_KEY=
LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# json_schema (best) | json_object | none  -- switch if your model/provider rejects json_schema
LLM_JSON_MODE=json_schema
LLM_TIMEOUT_MS=25000
PORT=8000
