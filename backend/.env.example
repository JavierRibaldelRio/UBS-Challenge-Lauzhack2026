# Copy to .env and fill in LLM_API_KEY. Any OpenAI-compatible endpoint works.
LLM_BASE_URL=https://api.together.ai/v1
LLM_API_KEY=
LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
# off = no thinking (fast, recommended) | on | default (send nothing; use for non-Together providers)
LLM_REASONING=off
# json_schema (best) | json_object | none  -- switch if your model/provider rejects json_schema
LLM_JSON_MODE=json_schema
LLM_TIMEOUT_MS=25000
PORT=8000
